{
  "permissions": {
    "allow": [
      "Bash(pytest:*)",
      "Bash(ruff:*)"
    ],
    "deny": [
      "Read(./datos-privados/**)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "ruff format ." }]
      }
    ]
  }
}